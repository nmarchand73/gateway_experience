---
/**
 * CRT glass overlay (afterglow-crt) + intensity helpers.
 * Intensity is driven by html[data-crt]: full | listen | off
 *
 * Layers (research: libretro CRT / crt-fx — CSS stand-ins, no WebGL):
 * - scanlines + refresh beam (afterglow)
 * - slot/grille mask (vertical phosphor structure)
 * - soft film grain / noise
 * - curved glass vignette + corner falloff
 * - phosphor bloom on text (halation)
 */
---

<div class="screen" aria-hidden="true" data-crt-screen>
  <div class="beam"></div>
  <div class="crt-mask"></div>
  <div class="crt-noise"></div>
  <div class="crt-bloom"></div>
</div>

<script>
  const KEY = 'gateway-crt-intensity';

  function preferredOff() {
    try {
      if (localStorage.getItem(KEY) === 'off') return true;
    } catch {
      /* ignore */
    }
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function setCrt(mode) {
    // User (or reduced-motion) turned CRT off — never re-enable on play.
    if (mode === 'listen' && preferredOff()) {
      document.documentElement.setAttribute('data-crt', 'off');
      return;
    }
    document.documentElement.setAttribute('data-crt', mode);
  }

  function restoreNavMode() {
    setCrt(preferredOff() ? 'off' : 'full');
  }

  // Boot: respect stored preference / reduced motion before paint if possible
  if (!document.documentElement.hasAttribute('data-crt')) {
    restoreNavMode();
  }

  // Expose for player + boot
  window.__gatewayCrt = {
    set: setCrt,
    restore: restoreNavMode,
  };

  document.querySelectorAll('[data-crt-toggle]').forEach((btn) => {
    btn.setAttribute('aria-pressed', String(preferredOff()));
    btn.addEventListener('click', () => {
      const next = document.documentElement.getAttribute('data-crt') === 'off' ? 'full' : 'off';
      try {
        localStorage.setItem(KEY, next === 'off' ? 'off' : 'full');
      } catch {
        /* ignore */
      }
      setCrt(next);
      btn.setAttribute('aria-pressed', String(next === 'off'));
    });
  });
</script>

<style is:global>
  /* Tuned mono-green terminal CRT (P1 phosphor feel) */
  html[data-crt='full'] {
    --crt-scanline-size: 1px;
    --crt-scanline-dark: 0.34;
    --crt-scanline-light: 0.03;
    --crt-scanline-opacity: 0.72;
    --crt-ghost-opacity: 0.055;
    --crt-ghost-blur: 2.5px;
    --crt-breath-brightness: 1.045;
    --crt-flicker-speed: 3.2s;
    --crt-warp-x: 1.0012;
    --crt-warp-y: 0.9988;
    --crt-warp-speed: 7.5s;
    --crt-beam-opacity: 0.42;
    --crt-beam-height: 110px;
    --crt-beam-speed: 11s;
    --crt-overscan: -2px;
  }

  html[data-crt='full'] body.crt-green {
    text-shadow:
      0 0 1px rgba(180, 255, 160, 0.55),
      0 0 8px rgba(108, 255, 108, 0.42),
      0 0 18px rgba(57, 255, 20, 0.18),
      0.6px 0 rgba(255, 80, 40, 0.08),
      -0.6px 0 rgba(40, 180, 255, 0.07);
  }

  /* Glass: stronger barrel-like vignette + soft center reflection */
  html[data-crt='full'] .screen {
    box-shadow:
      inset 0 0 60px rgba(0, 0, 0, 0.85),
      inset 0 0 120px rgba(0, 0, 0, 0.55),
      inset 0 0 180px rgba(0, 18, 0, 0.35);
  }

  html[data-crt='full'] .screen::after {
    background:
      radial-gradient(
        ellipse 78% 68% at 50% 42%,
        rgba(180, 255, 170, 0.07) 0%,
        rgba(255, 255, 255, 0.04) 28%,
        transparent 58%
      ),
      radial-gradient(
        ellipse at center,
        transparent 42%,
        rgba(0, 0, 0, 0.35) 72%,
        rgba(0, 0, 0, 0.78) 100%
      );
  }

  /* Scanlines: slight phosphor tint in the “light” band */
  html[data-crt='full'] .screen::before {
    background: repeating-linear-gradient(
      to bottom,
      rgba(0, 0, 0, var(--crt-scanline-dark)) 0px,
      rgba(0, 0, 0, var(--crt-scanline-dark)) var(--crt-scanline-size),
      rgba(40, 90, 40, var(--crt-scanline-light)) var(--crt-scanline-size),
      rgba(40, 90, 40, var(--crt-scanline-light)) calc(var(--crt-scanline-size) * 2)
    );
  }

  /* Vertical slot mask — mono CRT grille (not RGB triad) */
  .screen .crt-mask {
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
    opacity: 0;
    background: repeating-linear-gradient(
      to right,
      transparent 0,
      transparent 2px,
      rgba(0, 0, 0, 0.28) 2px,
      rgba(0, 0, 0, 0.28) 3px
    );
    mix-blend-mode: multiply;
  }

  html[data-crt='full'] .screen .crt-mask {
    opacity: 0.32;
  }

  /* Soft film grain / phosphor noise */
  .screen .crt-noise {
    position: absolute;
    inset: -10%;
    z-index: 5;
    pointer-events: none;
    opacity: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 180px 180px;
    mix-blend-mode: soft-light;
    animation: crtNoiseDrift 1.2s steps(3) infinite;
  }

  html[data-crt='full'] .screen .crt-noise {
    opacity: 0.085;
  }

  @keyframes crtNoiseDrift {
    0% { transform: translate(0, 0); }
    33% { transform: translate(-1.5%, 1%); }
    66% { transform: translate(1%, -1.2%); }
    100% { transform: translate(0, 0); }
  }

  /* Center halation / phosphor bloom wash */
  .screen .crt-bloom {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(
      ellipse 70% 55% at 50% 45%,
      rgba(57, 255, 20, 0.07) 0%,
      rgba(57, 255, 20, 0.02) 45%,
      transparent 70%
    );
    mix-blend-mode: screen;
  }

  html[data-crt='full'] .screen .crt-bloom {
    opacity: 1;
  }

  /* Softer refresh beam for green terminal */
  html[data-crt='full'] .screen .beam {
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(120, 255, 120, 0.04) 40%,
      rgba(180, 255, 180, 0.14) 50%,
      rgba(120, 255, 120, 0.04) 60%,
      transparent 100%
    );
  }

  /* Dampen CRT during listening — keep glass readable, kill motion */
  html[data-crt='listen'] {
    --crt-scanline-opacity: 0.28;
    --crt-scanline-dark: 0.16;
    --crt-scanline-light: 0.02;
    --crt-scanline-size: 1px;
    --crt-warp-x: 1;
    --crt-warp-y: 1;
    --crt-breath-brightness: 1;
    --crt-flicker-speed: 99999s;
    --crt-beam-opacity: 0;
    --crt-ghost-opacity: 0.02;
  }

  html[data-crt='listen'] .screen {
    animation: none !important;
    box-shadow:
      inset 0 0 50px rgba(0, 0, 0, 0.65),
      inset 0 0 100px rgba(0, 0, 0, 0.4);
  }

  html[data-crt='listen'] .screen .beam {
    display: none;
  }

  html[data-crt='listen'] .screen .crt-mask {
    opacity: 0.18;
  }

  html[data-crt='listen'] .screen .crt-noise {
    opacity: 0.04;
    animation: none;
  }

  html[data-crt='listen'] .screen .crt-bloom {
    opacity: 0.45;
  }

  html[data-crt='listen'] .screen::after {
    background: radial-gradient(
      ellipse at center,
      transparent 48%,
      rgba(0, 0, 0, 0.28) 78%,
      rgba(0, 0, 0, 0.62) 100%
    );
  }

  html[data-crt='listen'] body::after {
    opacity: 0.02 !important;
  }

  html[data-crt='listen'] body.crt-green {
    text-shadow:
      0 0 4px rgba(108, 255, 108, 0.22),
      0 0 12px rgba(57, 255, 20, 0.08);
  }

  /* Full off — accessibility / preference */
  html[data-crt='off'] {
    --crt-scanline-opacity: 0;
    --crt-beam-opacity: 0;
    --crt-ghost-opacity: 0;
    --crt-warp-x: 1;
    --crt-warp-y: 1;
    --crt-breath-brightness: 1;
  }

  html[data-crt='off'] .screen,
  html[data-crt='off'] body::after {
    display: none !important;
  }

  html[data-crt='off'] body.crt-green {
    text-shadow: none;
  }

  @media (prefers-reduced-motion: reduce) {
    html[data-crt='full'] .screen {
      animation: none !important;
    }
    html[data-crt='full'] .screen .beam,
    html[data-crt='full'] .screen .crt-noise {
      display: none;
    }
  }
</style>
