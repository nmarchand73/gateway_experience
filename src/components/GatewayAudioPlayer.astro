---
import { t } from '../i18n';
import type { Locale } from '../i18n';
import { resolvePdfUrl, CIA_GATEWAY_REPORT_PATH } from '../lib/media';

interface Props {
  src: string;
  downloadHref: string;
  locale: Locale;
  /** Collapses spectrum / reference panel by default. */
  listenerMode?: boolean;
  /** Session name shown at top of fullscreen live analysis. */
  sessionTitle?: string;
  /** Optional Wave · index · Focus line under the session title. */
  sessionMeta?: string;
  leftHz?: number | null;
  rightHz?: number | null;
  beatHz?: number;
  focusLevel?: number;
  bandLabel?: string;
  reviewed?: boolean;
}

const {
  src,
  downloadHref,
  locale,
  listenerMode = false,
  sessionTitle = '',
  sessionMeta = '',
  leftHz = null,
  rightHz = null,
  beatHz,
  focusLevel,
  bandLabel = '',
  reviewed = false,
} = Astro.props;

const fmtHz = (v: number | null | undefined) =>
  v == null ? '—' : `${v.toFixed(v % 1 ? 1 : 0)} Hz`;

const ciaReportUrl = resolvePdfUrl(CIA_GATEWAY_REPORT_PATH);
const livePeakLabel = t(locale, 'player.livePeak');
const analysisOffMsg = t(locale, 'player.analysisOff');
const analysisSilentMsg = t(locale, 'player.analysisSilent');
const analysisMonoMsg = t(locale, 'player.analysisMono');
const loadErrorMsg = t(locale, 'player.loadError');
const playCmd = t(locale, 'player.playCmd');
const pauseCmd = t(locale, 'player.pauseCmd');
const fullscreenCmd = t(locale, 'player.fullscreenCmd');
const fullscreenExitCmd = t(locale, 'player.fullscreenExitCmd');
const fullscreenEnterLabel = t(locale, 'player.fullscreenEnter');
const fullscreenExitLabel = t(locale, 'player.fullscreenExit');
---

<section class="player-wrap" data-gateway-player data-state="idle">
  <audio preload="metadata" src={src} data-audio crossorigin="anonymous" class="sr-audio">
    <p class="muted">{t(locale, 'player.noFlac')} <a href={downloadHref}>{t(locale, 'session.download')}</a></p>
  </audio>

  <p class="deck-banner mono" aria-hidden="true">DECK // HEMI-SYNC // PHONES</p>
  <div class="live-stage" data-live-stage>
    <header class="live-scope-session" data-live-session>
      <p class="live-scope-session-name">{sessionTitle || t(locale, 'player.spectrumPanel')}</p>
      {sessionMeta && <p class="live-scope-session-meta mono">{sessionMeta}</p>}
    </header>

    <div class="player-transport">
      <button type="button" class="btn-play" data-play aria-label={t(locale, 'player.play')}>
        <span aria-hidden="true">[</span>
        <span data-play-cmd>{playCmd}</span>
        <span aria-hidden="true">]</span>
      </button>

      <div class="transport-main">
        <div class="scrub-wrap">
          <span class="scrub-ascii mono" data-scrub-ascii aria-hidden="true">[&gt;-----------------------------]</span>
          <input type="range" min="0" max="1000" value="0" step="1" class="scrub" data-scrub aria-label={t(locale, 'player.seek')} />
        </div>
        <div class="transport-row">
          <span class="time mono">
            <span data-current>0:00</span><span class="time-sep">/</span><span data-duration>--:--</span>
          </span>
          <div class="transport-tools">
            <button type="button" class="btn-icon" data-skip="-10" aria-label={t(locale, 'player.skipBack')}>-10</button>
            <button type="button" class="btn-icon" data-skip="10" aria-label={t(locale, 'player.skipForward')}>+10</button>
            <label class="speed">
              <span class="ctl-k">{t(locale, 'player.rate')}</span>
              <select data-speed aria-label={t(locale, 'player.speed')}>
                <option value="0.8">0.8x</option>
                <option value="1" selected>1.0x</option>
                <option value="1.25">1.25x</option>
                <option value="1.5">1.5x</option>
              </select>
            </label>
            <label class="volume" title={t(locale, 'player.volume')}>
              <span class="ctl-k">{t(locale, 'player.vol')}</span>
              <span class="vol-ascii mono" data-vol-ascii aria-hidden="true">[##########]</span>
              <input type="range" min="0" max="100" value="100" step="1" class="vol-slider" data-volume aria-label={t(locale, 'player.volume')} />
            </label>
          </div>
        </div>
      </div>
    </div>

  <div class="live-scope" data-live-scope aria-hidden="true">
    <div class="live-scope-head">
      <span class="live-scope-title">{t(locale, 'player.spectrumPanel')}</span>
      <span class="live-scope-hint mono">{t(locale, 'player.spectrumRange')} · {t(locale, 'player.spectrumCaption')}</span>
      <button
        type="button"
        class="btn-icon live-fs-btn"
        data-live-fs
        aria-pressed="false"
        aria-label={t(locale, 'player.fullscreenEnter')}
        title={t(locale, 'player.fullscreenEnter')}
      >
        <span data-live-fs-label>{t(locale, 'player.fullscreenCmd')}</span>
      </button>
    </div>
    <p class="analysis-status muted" data-analysis-status hidden></p>
    <div class="live-stats" data-live-detect aria-live="polite">
      <div class="stat-card stat-l">
        <span class="stat-k">{t(locale, 'player.detectL')}</span>
        <span class="stat-v mono" data-detect-l>—</span>
      </div>
      <div class="stat-card stat-r">
        <span class="stat-k">{t(locale, 'player.detectR')}</span>
        <span class="stat-v mono phosphor-amber" data-detect-r>—</span>
      </div>
      <div class="stat-card stat-beat">
        <span class="stat-k">{t(locale, 'player.detectBeat')}</span>
        <span class="stat-v mono phosphor-amber" data-detect-beat>—</span>
      </div>
    </div>
    <div class="brain-legend-marks" aria-hidden="true">
      <span class="brain-mark carrier">{t(locale, 'player.spectrumCarrier')}</span>
      <span class="brain-mark detected">{t(locale, 'player.spectrumDetected')}</span>
    </div>
    <div class="spectrum-row">
      <div class="viz-block viz-l">
        <div class="viz-head">
          <span class="viz-channel">{t(locale, 'player.spectrumL')}</span>
          <span class="viz-peak mono" data-peak-l>—</span>
        </div>
        <canvas class="viz-canvas" data-viz-l width="960" height="280" role="img" aria-label={t(locale, 'player.spectrumL')}></canvas>
      </div>
      <div class="viz-block viz-r">
        <div class="viz-head">
          <span class="viz-channel">{t(locale, 'player.spectrumR')}</span>
          <span class="viz-peak mono phosphor-amber" data-peak-r>—</span>
        </div>
        <canvas class="viz-canvas" data-viz-r width="960" height="280" role="img" aria-label={t(locale, 'player.spectrumR')}></canvas>
      </div>
    </div>
    <div class="brain-dist" data-brain-dist aria-label={t(locale, 'player.bandDistLabel')}>
      <p class="brain-dist-title">{t(locale, 'player.bandDistLabel')}</p>
      <div class="brain-dist-meters">
        <div class="brain-band-meter delta" data-band="delta">
          <div class="brain-band-head">
            <span class="brain-band-k">δ</span>
            <span class="brain-band-range">1–4 Hz</span>
            <span class="brain-band-pct mono" data-band-pct="delta">—</span>
          </div>
          <div class="brain-band-track" aria-hidden="true">
            <div class="brain-band-fill" data-band-fill="delta"></div>
            <div class="brain-band-hold" data-band-hold="delta"></div>
          </div>
        </div>
        <div class="brain-band-meter theta" data-band="theta">
          <div class="brain-band-head">
            <span class="brain-band-k">θ</span>
            <span class="brain-band-range">4–8 Hz</span>
            <span class="brain-band-pct mono" data-band-pct="theta">—</span>
          </div>
          <div class="brain-band-track" aria-hidden="true">
            <div class="brain-band-fill" data-band-fill="theta"></div>
            <div class="brain-band-hold" data-band-hold="theta"></div>
          </div>
        </div>
        <div class="brain-band-meter alpha" data-band="alpha">
          <div class="brain-band-head">
            <span class="brain-band-k">α</span>
            <span class="brain-band-range">8–13 Hz</span>
            <span class="brain-band-pct mono" data-band-pct="alpha">—</span>
          </div>
          <div class="brain-band-track" aria-hidden="true">
            <div class="brain-band-fill" data-band-fill="alpha"></div>
            <div class="brain-band-hold" data-band-hold="alpha"></div>
          </div>
        </div>
        <div class="brain-band-meter beta" data-band="beta">
          <div class="brain-band-head">
            <span class="brain-band-k">β</span>
            <span class="brain-band-range">13–30 Hz</span>
            <span class="brain-band-pct mono" data-band-pct="beta">—</span>
          </div>
          <div class="brain-band-track" aria-hidden="true">
            <div class="brain-band-fill" data-band-fill="beta"></div>
            <div class="brain-band-hold" data-band-hold="beta"></div>
          </div>
        </div>
        <div class="brain-band-meter gamma" data-band="gamma">
          <div class="brain-band-head">
            <span class="brain-band-k">γ</span>
            <span class="brain-band-range">30–150 Hz</span>
            <span class="brain-band-pct mono" data-band-pct="gamma">—</span>
          </div>
          <div class="brain-band-track" aria-hidden="true">
            <div class="brain-band-fill" data-band-fill="gamma"></div>
            <div class="brain-band-hold" data-band-hold="gamma"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
  </div>

  <div class="player-targets" aria-label={t(locale, 'player.targetsTitle')}>
    <p class="player-targets-title">{t(locale, 'player.targetsTitle')}</p>
    <table class="telemetry">
      <thead>
        <tr>
          <th>{t(locale, 'session.beat')}</th>
          <th title={t(locale, 'session.left')}>{t(locale, 'player.leftHdr')}</th>
          <th title={t(locale, 'session.right')}>{t(locale, 'player.rightHdr')}</th>
          <th>{t(locale, 'session.focus')}</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="mono">{beatHz != null ? `${beatHz} Hz` : '--'}</td>
          <td class="mono" data-freq-l>{fmtHz(leftHz)}</td>
          <td class="mono" data-freq-r>{fmtHz(rightHz)}</td>
          <td class="mono">{focusLevel ?? '--'}</td>
        </tr>
        <tr class="telemetry-live">
          <td class="mono"><span class="live-k">{t(locale, 'player.liveBeat')}</span> <span data-live-beat>--</span></td>
          <td class="mono" data-live-l></td>
          <td class="mono" data-live-r></td>
          <td></td>
        </tr>
      </tbody>
    </table>
    {bandLabel && (
      <p class="band-line mono"><span class="ctl-k">{t(locale, 'session.band')}</span> {bandLabel}</p>
    )}
    {beatHz != null && <p class="target-note muted">{t(locale, 'player.beatTargetNote')}</p>}
    {!reviewed && <p class="target-warn">{t(locale, 'session.unreviewedShort')}</p>}
    <p class="target-mss muted">{t(locale, 'player.ciaReportBody')}</p>
  </div>

  <div class="player-actions">
    <a class="action-link" href={downloadHref} download>{t(locale, 'player.downloadFlac')}</a>
    {ciaReportUrl && (
      <a class="action-link" href={ciaReportUrl} target="_blank" rel="noopener">{t(locale, 'player.ciaReportLink')}</a>
    )}
    <a class="action-link" href="https://www.monroeinstituteuk.org/about-monroe-sound-science/" target="_blank" rel="noopener noreferrer">{t(locale, 'player.mssLink')}</a>
  </div>

  <details class="tech-panel">
    <summary>
      <span class="tech-summary-label">{t(locale, 'player.methodNotes')}</span>
    </summary>
    <div class="tech-panel-body">
      <p class="detect-hint muted">{t(locale, 'player.detectHint')}</p>
      <p class="brain-dist-hint muted">{t(locale, 'player.bandDistHint')}</p>
    </div>
  </details>
</section>

<script define:vars={{ leftHz, rightHz, beatHz, loadErrorMsg, livePeakLabel, analysisOffMsg, analysisSilentMsg, analysisMonoMsg, playCmd, pauseCmd, fullscreenCmd, fullscreenExitCmd, fullscreenEnterLabel, fullscreenExitLabel }}>
  document.querySelectorAll('[data-gateway-player]').forEach((root) => {
    const audio = root.querySelector('[data-audio]');
    if (!audio) return;

    const playBtn = root.querySelector('[data-play]');
    const playCmdEl = root.querySelector('[data-play-cmd]');
    const scrub = root.querySelector('[data-scrub]');
    const scrubAscii = root.querySelector('[data-scrub-ascii]');
    const currentEl = root.querySelector('[data-current]');
    const durationEl = root.querySelector('[data-duration]');
    const speedSel = root.querySelector('[data-speed]');
    const volumeEl = root.querySelector('[data-volume]');
    const volAscii = root.querySelector('[data-vol-ascii]');
    const canvasL = root.querySelector('[data-viz-l]');
    const canvasR = root.querySelector('[data-viz-r]');
    const techPanel = root.querySelector('.tech-panel');
    const liveStage = root.querySelector('[data-live-stage]');
    const liveScope = root.querySelector('[data-live-scope]');
    const liveFsBtn = root.querySelector('[data-live-fs]');
    const liveFsLabel = root.querySelector('[data-live-fs-label]');
    const detectL = root.querySelector('[data-detect-l]');
    const detectR = root.querySelector('[data-detect-r]');
    const detectBeat = root.querySelector('[data-detect-beat]');
    const peakLabelL = root.querySelector('[data-peak-l]');
    const peakLabelR = root.querySelector('[data-peak-r]');
    const liveL = root.querySelector('[data-live-l]');
    const liveR = root.querySelector('[data-live-r]');
    const liveBeat = root.querySelector('[data-live-beat]');
    const analysisStatus = root.querySelector('[data-analysis-status]');
    const bandMeters = root.querySelectorAll('.brain-band-meter');
    const bandPctEls = {
      delta: root.querySelector('[data-band-pct="delta"]'),
      theta: root.querySelector('[data-band-pct="theta"]'),
      alpha: root.querySelector('[data-band-pct="alpha"]'),
      beta: root.querySelector('[data-band-pct="beta"]'),
      gamma: root.querySelector('[data-band-pct="gamma"]'),
    };
    const bandFillEls = {
      delta: root.querySelector('[data-band-fill="delta"]'),
      theta: root.querySelector('[data-band-fill="theta"]'),
      alpha: root.querySelector('[data-band-fill="alpha"]'),
      beta: root.querySelector('[data-band-fill="beta"]'),
      gamma: root.querySelector('[data-band-fill="gamma"]'),
    };
    const bandHoldEls = {
      delta: root.querySelector('[data-band-hold="delta"]'),
      theta: root.querySelector('[data-band-hold="theta"]'),
      alpha: root.querySelector('[data-band-hold="alpha"]'),
      beta: root.querySelector('[data-band-hold="beta"]'),
      gamma: root.querySelector('[data-band-hold="gamma"]'),
    };

    const fmt = (s) => {
      if (!isFinite(s) || s < 0) return '0:00';
      const m = Math.floor(s / 60);
      const ss = Math.floor(s % 60);
      return `${m}:${String(ss).padStart(2, '0')}`;
    };

    const fsElement = () =>
      document.fullscreenElement || document.webkitFullscreenElement || null;

    const syncLiveFullscreenUi = () => {
      if (!liveStage) return;
      const active =
        liveStage.classList.contains('is-fs') || fsElement() === liveStage;
      liveStage.classList.toggle('is-fs', active);
      root.classList.toggle('is-live-fs', active);
      if (liveFsBtn) {
        liveFsBtn.setAttribute('aria-pressed', active ? 'true' : 'false');
        liveFsBtn.setAttribute(
          'aria-label',
          active ? fullscreenExitLabel : fullscreenEnterLabel,
        );
        liveFsBtn.title = active ? fullscreenExitLabel : fullscreenEnterLabel;
      }
      if (liveFsLabel) {
        liveFsLabel.textContent = active ? fullscreenExitCmd : fullscreenCmd;
      }
    };

    const enterLiveFullscreen = async () => {
      if (!liveStage) return;
      // Playwright / automation: native Fullscreen API is flaky; use CSS overlay.
      if (navigator.webdriver) {
        liveStage.classList.add('is-fs');
        syncLiveFullscreenUi();
        return;
      }
      try {
        if (liveStage.requestFullscreen) await liveStage.requestFullscreen();
        else if (liveStage.webkitRequestFullscreen) liveStage.webkitRequestFullscreen();
        else liveStage.classList.add('is-fs');
      } catch (_) {
        liveStage.classList.add('is-fs');
      }
      syncLiveFullscreenUi();
    };

    const exitLiveFullscreen = async () => {
      if (!liveStage) return;
      liveStage.classList.remove('is-fs');
      try {
        const cur = fsElement();
        if (cur === liveStage) {
          if (document.exitFullscreen) await document.exitFullscreen();
          else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
        }
      } catch (_) {}
      syncLiveFullscreenUi();
    };

    const toggleLiveFullscreen = async () => {
      if (!liveStage) return;
      const active =
        liveStage.classList.contains('is-fs') || fsElement() === liveStage;
      if (active) await exitLiveFullscreen();
      else await enterLiveFullscreen();
    };

    const setPlayerState = () => {
      const playing = !audio.paused && !audio.ended;
      root.dataset.state = playing ? 'playing' : audio.ended ? 'ended' : 'idle';
      if (playCmdEl) playCmdEl.textContent = playing ? pauseCmd : playCmd;
      if (liveScope) liveScope.setAttribute('aria-hidden', playing ? 'false' : 'true');
      if (!playing) exitLiveFullscreen();
      const crt = window.__gatewayCrt;
      let crtOff = false;
      try {
        crtOff = localStorage.getItem('gateway-crt-intensity') === 'off';
      } catch (_) {}
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) crtOff = true;
      if (crt) {
        if (playing && !crtOff) crt.set('listen');
        else crt.restore();
      } else {
        document.documentElement.setAttribute(
          'data-crt',
          crtOff ? 'off' : playing ? 'listen' : 'full',
        );
      }
    };

    const asciiVol = (pct, width = 10) => {
      const n = Math.round((Math.max(0, Math.min(100, pct)) / 100) * width);
      return `[${'#'.repeat(n)}${'-'.repeat(width - n)}]`;
    };

    const asciiTrack = (pct, width = 30) => {
      const p = Math.max(0, Math.min(100, pct));
      const pos = Math.round((p / 100) * (width - 1));
      let s = '';
      for (let i = 0; i < width; i++) s += i < pos ? '=' : i === pos ? '>' : '-';
      return `[${s}]`;
    };

    const applyVolume = (pct) => {
      const v = Math.max(0, Math.min(1, pct / 100));
      audio.volume = v;
      if (gainNode) gainNode.gain.value = v;
      if (volAscii) volAscii.textContent = asciiVol(pct);
    };

    let ac = null;
    let gainNode = null;
    let splitter = null;
    let analyserL = null;
    let analyserR = null;
    let dataL = null;
    let dataR = null;
    let floatL = null;
    let floatR = null;
    let uniqueL = null;
    let uniqueR = null;
    let timeL = null;
    let timeR = null;
    let startBin = 0;
    let endBin = 0;
    let binHz = 1.346;
    let raf = 0;
    let vizActive = false;
    let smoothPeakL = null;
    let smoothPeakR = null;
    let smoothBeat = null;
    let smoothBandPct = { delta: 0.2, theta: 0.2, alpha: 0.2, beta: 0.2, gamma: 0.2 };
    let bandHoldPct = { delta: 0, theta: 0, alpha: 0, beta: 0, gamma: 0 };
    let bandHoldUntil = { delta: 0, theta: 0, alpha: 0, beta: 0, gamma: 0 };
    let specHoldL = null;
    let specHoldR = null;
    let specHoldUntilL = null;
    let specHoldUntilR = null;
    let holdClock = 0;
    let stereoLikely = true;
    let stereoFrames = 0;

    const F_LOW = 1;
    const F_HIGH = 4000;
    /** Axis ticks — Monroe UK band edges + decades for readable log scale. */
    const AXIS_TICKS = [1, 4, 8, 13, 30, 150, 500, 1000, 4000];
    const CARRIER_LO = 80;
    const CARRIER_HI = 1200;
    const PEAK_SMOOTH = 0.88;
    const BAND_SMOOTH = 0.86;
    /**
     * Peak-hold timing aligned with common analyzer practice:
     * - ITU-R BS.1771: peak lamps stay ≥150 ms so the eye can catch them
     * - Spectrum UIs (e.g. Outboard): decaying peaks ≈ 6–12 dB/s (we use ~18 for snappier EQ feel)
     * Attack is instantaneous; hold then exponential fall in linear display space.
     */
    const PEAK_HOLD_MS = 160;
    const PEAK_FALL_DB_PER_S = 18;

    const peakHoldStep = (prev, until, next, now, dt) => {
      if (next >= prev) return { v: next, until: now + PEAK_HOLD_MS };
      if (now < until) return { v: prev, until };
      const decay = Math.pow(10, (-PEAK_FALL_DB_PER_S * Math.max(0.001, dt)) / 20);
      return { v: Math.max(next, prev * decay), until };
    };

    const BAND_DEFS = [
      { id: 'delta', lo: 1, hi: 4, fill: 'rgba(108, 255, 108, 0.03)' },
      { id: 'theta', lo: 4, hi: 8, fill: 'rgba(108, 255, 108, 0.05)' },
      { id: 'alpha', lo: 8, hi: 13, fill: 'rgba(108, 255, 108, 0.08)' },
      { id: 'beta', lo: 13, hi: 30, fill: 'rgba(108, 255, 108, 0.05)' },
      { id: 'gamma', lo: 30, hi: 150, fill: 'rgba(108, 255, 108, 0.03)' },
    ];
    const BRAIN_BANDS = BAND_DEFS;
    const logF = (hz) => Math.log10(hz);
    const logSpan = logF(F_HIGH) - logF(F_LOW);

    const hzToX = (hz, w, pad) => {
      const t = (logF(Math.max(F_LOW, Math.min(F_HIGH, hz))) - logF(F_LOW)) / logSpan;
      return pad + t * (w - pad * 2);
    };

    const hzAtT = (t) => 10 ** (logF(F_LOW) + t * logSpan);

    const fmtTick = (hz) => (hz >= 1000 ? `${hz / 1000}k` : String(hz));

    const fmtPeak = (hz) => {
      if (hz == null || !isFinite(hz)) return '—';
      if (hz < 10) return `${hz.toFixed(1)} Hz`;
      if (hz < 100) return `${hz.toFixed(1)} Hz`;
      return `${Math.round(hz)} Hz`;
    };

    const smoothVal = (prev, next) =>
      prev == null ? next : PEAK_SMOOTH * prev + (1 - PEAK_SMOOTH) * next;

    /** Parabolic peak in [lo, hi] Hz on float dB spectrum. */
    const findPeakInRange = (floatData, lo, hi, floorDb = -72) => {
      if (!floatData) return null;
      const b0 = Math.max(startBin + 1, Math.floor(lo / binHz));
      const b1 = Math.min(endBin - 1, Math.ceil(hi / binHz));
      if (b0 >= b1) return null;
      let bestBin = b0;
      let bestVal = -Infinity;
      for (let k = b0; k <= b1; k++) {
        if (floatData[k] > bestVal) {
          bestVal = floatData[k];
          bestBin = k;
        }
      }
      if (bestVal < floorDb) return null;
      const y0 = floatData[bestBin - 1];
      const y1 = floatData[bestBin];
      const y2 = floatData[bestBin + 1];
      const denom = y0 - 2 * y1 + y2;
      const delta = denom !== 0 ? 0.5 * (y0 - y2) / denom : 0;
      return (bestBin + delta) * binHz;
    };

    /**
     * Ear-unique spectrum: max(0, magMine − magOther) in dB.
     * Cancels guided voice / music that is common to both ears so L and R
     * carriers can be read independently.
     */
    const fillUniqueSpectrum = (mineDb, otherDb, outDb) => {
      for (let k = 0; k < mineDb.length; k++) {
        const a = 10 ** (mineDb[k] / 20);
        const b = 10 ** (otherDb[k] / 20);
        const u = Math.max(0, a - b);
        outDb[k] = u > 1e-12 ? 20 * Math.log10(u) : -120;
      }
    };

    const sampleStereoLikelihood = () => {
      if (!analyserL || !analyserR || !timeL || !timeR) return;
      analyserL.getFloatTimeDomainData(timeL);
      analyserR.getFloatTimeDomainData(timeR);
      let sumDiff = 0;
      let sumPow = 0;
      for (let i = 0; i < timeL.length; i++) {
        const d = timeL[i] - timeR[i];
        sumDiff += d * d;
        sumPow += timeL[i] * timeL[i] + timeR[i] * timeR[i];
      }
      const sideRatio = Math.sqrt(sumDiff) / (Math.sqrt(sumPow) + 1e-12);
      // True mono (or duplicated L→R) sits near 0; stereo Hemi-Sync has a side image.
      stereoLikely = sideRatio > 0.02;
    };

    const detectPeaks = () => {
      if (!floatL || !floatR || !uniqueL || !uniqueR) {
        return { peakL: null, peakR: null, beat: null };
      }
      fillUniqueSpectrum(floatL, floatR, uniqueL);
      fillUniqueSpectrum(floatR, floatL, uniqueR);

      // Prefer ear-unique carriers; fall back to raw peak if unique is silent.
      let rawL = findPeakInRange(uniqueL, CARRIER_LO, CARRIER_HI, -85);
      let rawR = findPeakInRange(uniqueR, CARRIER_LO, CARRIER_HI, -85);
      if (rawL == null) rawL = findPeakInRange(floatL, CARRIER_LO, CARRIER_HI);
      if (rawR == null) rawR = findPeakInRange(floatR, CARRIER_LO, CARRIER_HI);

      if (rawL != null) smoothPeakL = smoothVal(smoothPeakL, rawL);
      if (rawR != null) smoothPeakR = smoothVal(smoothPeakR, rawR);
      if (smoothPeakL != null && smoothPeakR != null) {
        smoothBeat = smoothVal(smoothBeat, Math.abs(smoothPeakL - smoothPeakR));
      }
      return { peakL: smoothPeakL, peakR: smoothPeakR, beat: smoothBeat };
    };

    /** Linear energy per EEG band (1–150 Hz, Monroe UK), averaged L+R. */
    const measureBandDistribution = () => {
      if (!floatL || !floatR) return null;
      const raw = BAND_DEFS.map(({ lo, hi }) => {
        const b0 = Math.max(startBin, Math.floor(lo / binHz));
        const b1 = Math.min(endBin, Math.ceil(hi / binHz));
        if (b0 >= b1) return 0;
        let sum = 0;
        for (let k = b0; k < b1; k++) {
          const l = 10 ** (floatL[k] / 20);
          const r = 10 ** (floatR[k] / 20);
          sum += (l + r) * 0.5;
        }
        return sum / (b1 - b0);
      });
      const total = raw.reduce((a, b) => a + b, 0);
      if (total <= 1e-12) return null;
      return raw.map((v) => v / total);
    };

    const updateBandDistribution = (playing) => {
      if (!playing) {
        for (const id of BAND_DEFS) {
          const key = id.id;
          if (bandPctEls[key]) bandPctEls[key].textContent = '—';
          if (bandFillEls[key]) bandFillEls[key].style.height = '0%';
          if (bandHoldEls[key]) bandHoldEls[key].style.bottom = '0%';
          bandHoldPct[key] = 0;
          bandHoldUntil[key] = 0;
        }
        bandMeters.forEach((el) => el.classList.remove('is-dominant'));
        return;
      }
      const dist = measureBandDistribution();
      if (!dist) return;
      const now = performance.now();
      const dt = holdClock ? Math.min(0.05, (now - holdClock) / 1000) : 1 / 60;
      let dominant = 'alpha';
      let maxPct = 0;
      BAND_DEFS.forEach(({ id }, i) => {
        const prev = smoothBandPct[id];
        smoothBandPct[id] = BAND_SMOOTH * prev + (1 - BAND_SMOOTH) * dist[i];
        const pct = Math.max(0, Math.min(100, smoothBandPct[id] * 100));
        if (bandPctEls[id]) bandPctEls[id].textContent = `${Math.round(pct)}%`;
        if (bandFillEls[id]) bandFillEls[id].style.height = `${Math.max(2, pct)}%`;

        const stepped = peakHoldStep(bandHoldPct[id], bandHoldUntil[id], pct, now, dt);
        bandHoldPct[id] = stepped.v;
        bandHoldUntil[id] = stepped.until;
        if (bandHoldEls[id]) {
          bandHoldEls[id].style.bottom = `${Math.max(0, Math.min(100, bandHoldPct[id]))}%`;
          bandHoldEls[id].style.opacity = bandHoldPct[id] > 1 ? '1' : '0';
        }

        if (pct > maxPct) {
          maxPct = pct;
          dominant = id;
        }
      });
      bandMeters.forEach((el) => {
        el.classList.toggle('is-dominant', el.dataset.band === dominant && maxPct > 18);
      });
    };

    const updateDetectUI = ({ peakL, peakR, beat }) => {
      const playing = !audio.paused && !audio.ended;
      const lText = playing ? fmtPeak(peakL) : '—';
      const rText = playing ? fmtPeak(peakR) : '—';
      const bText = playing && beat != null && beat >= 0.5 ? fmtPeak(beat) : '—';
      if (detectL) detectL.textContent = lText;
      if (detectR) detectR.textContent = rText;
      if (detectBeat) detectBeat.textContent = bText;
      if (peakLabelL) peakLabelL.textContent = lText;
      if (peakLabelR) peakLabelR.textContent = rText;
      if (liveL) liveL.textContent = playing && peakL != null ? `${livePeakLabel} ${fmtPeak(peakL)}` : '';
      if (liveR) liveR.textContent = playing && peakR != null ? `${livePeakLabel} ${fmtPeak(peakR)}` : '';
      if (liveBeat) liveBeat.textContent = bText;
      updateBandDistribution(playing);
    };

    const setupGraph = async () => {
      if (ac) {
        if (ac.state === 'suspended') await ac.resume();
        startViz();
        return;
      }
      const AudioCtx = window.AudioContext || window.webkitAudioContext;
      if (!AudioCtx) return;
      ac = new AudioCtx();
      gainNode = ac.createGain();
      gainNode.gain.value = volumeEl ? Number(volumeEl.value) / 100 : 1;

      const source = ac.createMediaElementSource(audio);
      // Force discrete stereo so ChannelSplitter does not upmix/downmix L into R.
      try {
        source.channelCount = 2;
        source.channelCountMode = 'explicit';
        source.channelInterpretation = 'discrete';
      } catch (_) {}

      splitter = ac.createChannelSplitter(2);
      try {
        splitter.channelCount = 2;
        splitter.channelCountMode = 'explicit';
        splitter.channelInterpretation = 'discrete';
      } catch (_) {}

      analyserL = ac.createAnalyser();
      analyserR = ac.createAnalyser();
      // Max Web Audio FFT → ~1.3 Hz bins at 44.1 kHz (was ~5.4 Hz at 8192).
      const FFT = 32768;
      analyserL.fftSize = FFT;
      analyserR.fftSize = FFT;
      analyserL.smoothingTimeConstant = 0.75;
      analyserR.smoothingTimeConstant = 0.75;
      try {
        analyserL.channelCount = 1;
        analyserR.channelCount = 1;
        analyserL.channelCountMode = 'explicit';
        analyserR.channelCountMode = 'explicit';
      } catch (_) {}

      dataL = new Uint8Array(analyserL.frequencyBinCount);
      dataR = new Uint8Array(analyserR.frequencyBinCount);
      floatL = new Float32Array(analyserL.frequencyBinCount);
      floatR = new Float32Array(analyserR.frequencyBinCount);
      uniqueL = new Float32Array(analyserL.frequencyBinCount);
      uniqueR = new Float32Array(analyserR.frequencyBinCount);
      timeL = new Float32Array(analyserL.fftSize);
      timeR = new Float32Array(analyserR.fftSize);

      binHz = ac.sampleRate / analyserL.fftSize;
      startBin = Math.max(0, Math.floor(F_LOW / binHz));
      endBin = Math.min(analyserL.frequencyBinCount, Math.ceil(F_HIGH / binHz));

      source.connect(splitter);
      splitter.connect(analyserL, 0);
      splitter.connect(analyserR, 1);
      source.connect(gainNode);
      gainNode.connect(ac.destination);

      stereoLikely = true;
      stereoFrames = 0;

      if (ac.state === 'suspended') await ac.resume();
      startViz();
    };

    const drawVLine = (ctx, x, top, bottom, color, width = 1, dash = []) => {
      ctx.save();
      ctx.strokeStyle = color;
      ctx.lineWidth = width;
      ctx.setLineDash(dash);
      ctx.beginPath();
      ctx.moveTo(x, top);
      ctx.lineTo(x, bottom);
      ctx.stroke();
      ctx.restore();
    };

    const drawSpectrum = (canvas, data, carrierHz, detectedHz, channel = 'l') => {
      if (!canvas || !data) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      if (w < 8 || h < 8) return;
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      if (canvas.width !== Math.floor(w * dpr)) {
        canvas.width = Math.floor(w * dpr);
        canvas.height = Math.floor(h * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }

      const padX = 10;
      const top = 14;
      const axisH = 22;
      const usableH = h - top - axisH;
      const plotBottom = top + usableH;

      const isR = channel === 'r';
      const grid = isR ? 'rgba(255, 176, 0, 0.18)' : 'rgba(108, 255, 108, 0.22)';
      const gridSoft = isR ? 'rgba(255, 176, 0, 0.1)' : 'rgba(108, 255, 108, 0.12)';
      const axisInk = isR ? 'rgba(255, 176, 0, 0.65)' : 'rgba(108, 255, 108, 0.55)';
      const carrierInk = isR ? 'rgba(255, 210, 120, 0.7)' : 'rgba(108, 255, 108, 0.55)';
      const barBase = isR ? 'rgba(255, 176, 0, 0.9)' : 'rgba(57, 255, 20, 0.92)';
      const barGlow = isR ? 'rgba(255, 176, 0, 0.22)' : 'rgba(57, 255, 20, 0.22)';
      const holdColor = isR ? 'rgba(255, 210, 120, 0.98)' : 'rgba(255, 176, 0, 0.95)';

      ctx.fillStyle = isR ? '#100800' : '#001000';
      ctx.fillRect(0, 0, w, h);

      for (const band of BRAIN_BANDS) {
        const x0 = hzToX(band.lo, w, padX);
        const x1 = hzToX(Math.min(F_HIGH, band.hi), w, padX);
        ctx.fillStyle = band.fill;
        ctx.fillRect(x0, top, Math.max(1, x1 - x0), usableH);
      }

      ctx.strokeStyle = grid;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(padX, plotBottom);
      ctx.lineTo(w - padX, plotBottom);
      ctx.stroke();

      for (const hz of AXIS_TICKS) {
        const x = hzToX(hz, w, padX);
        drawVLine(ctx, x, top, plotBottom, gridSoft, 1);
      }

      const bars = Math.min(120, Math.max(64, Math.floor(w / 3)));
      const barW = (w - padX * 2) / bars;
      const holdRef = channel === 'r' ? specHoldR : specHoldL;
      if (!holdRef || holdRef.length !== bars) {
        const next = new Float32Array(bars);
        const until = new Float64Array(bars);
        if (channel === 'r') {
          specHoldR = next;
          specHoldUntilR = until;
        } else {
          specHoldL = next;
          specHoldUntilL = until;
        }
      }
      const holds = channel === 'r' ? specHoldR : specHoldL;
      const untils = channel === 'r' ? specHoldUntilR : specHoldUntilL;
      const now = performance.now();
      const dt = holdClock ? Math.min(0.05, (now - holdClock) / 1000) : 1 / 60;

      for (let i = 0; i < bars; i++) {
        const f0 = hzAtT(i / bars);
        const f1 = hzAtT((i + 1) / bars);
        const b0 = Math.max(startBin, Math.floor(f0 / binHz));
        const b1 = Math.min(endBin, Math.max(b0 + 1, Math.ceil(f1 / binHz)));
        let sum = 0;
        for (let k = b0; k < b1; k++) sum += data[k] || 0;
        const v = sum / (b1 - b0) / 255;
        const bh = Math.max(2, v * usableH);
        const x = padX + i * barW;
        const y = plotBottom - bh;
        const bw = Math.max(1.5, barW - 0.5);
        if (v > 0.12) {
          ctx.fillStyle = barGlow;
          ctx.fillRect(x, y - 2, bw, bh + 2);
        }
        ctx.fillStyle = barBase;
        ctx.globalAlpha = 0.55 + v * 0.45;
        ctx.fillRect(x, y, bw, bh);
        ctx.globalAlpha = 1;

        const stepped = peakHoldStep(holds[i], untils[i], v, now, dt);
        holds[i] = stepped.v;
        untils[i] = stepped.until;
        if (holds[i] > 0.03) {
          const hy = plotBottom - holds[i] * usableH;
          ctx.fillStyle = holdColor;
          ctx.fillRect(x, hy - 1, bw, 2);
        }
      }

      if (detectedHz != null && detectedHz >= F_LOW && detectedHz <= F_HIGH) {
        const x = hzToX(detectedHz, w, padX);
        drawVLine(ctx, x, top, plotBottom, 'rgba(255, 176, 0, 0.95)', 1, [3, 3]);
        ctx.fillStyle = 'rgba(255, 210, 120, 0.98)';
        ctx.font = '13px VT323, monospace';
        ctx.textAlign = 'center';
        ctx.fillText(fmtPeak(detectedHz).replace(' Hz', ''), x, top + 10);
      }

      if (carrierHz != null && carrierHz >= F_LOW && carrierHz <= F_HIGH) {
        const x = hzToX(carrierHz, w, padX);
        drawVLine(ctx, x, top, plotBottom, carrierInk, 1);
      }

      ctx.fillStyle = axisInk;
      ctx.font = '13px VT323, monospace';
      ctx.textAlign = 'center';
      const labelY = plotBottom + 16;
      for (const hz of AXIS_TICKS) {
        const x = hzToX(hz, w, padX);
        const label = hz < 10 ? `${hz} Hz` : fmtTick(hz);
        ctx.fillText(label, x, labelY);
      }
    };

    const render = () => {
      if (!vizActive || !analyserL || !analyserR) return;
      analyserL.getByteFrequencyData(dataL);
      analyserR.getByteFrequencyData(dataR);
      analyserL.getFloatFrequencyData(floatL);
      analyserR.getFloatFrequencyData(floatR);
      const peaks = detectPeaks();
      updateDetectUI(peaks);
      stereoFrames += 1;
      if (stereoFrames === 12 || stereoFrames % 90 === 0) sampleStereoLikelihood();
      if (analysisStatus) {
        let max = 0;
        for (let i = 0; i < dataL.length; i++) max = Math.max(max, dataL[i], dataR[i]);
        const silent = max < 2;
        if (silent && !audio.paused) {
          analysisStatus.hidden = false;
          analysisStatus.textContent = analysisSilentMsg;
        } else if (!audio.paused && !stereoLikely) {
          analysisStatus.hidden = false;
          analysisStatus.textContent = analysisMonoMsg;
        } else {
          analysisStatus.hidden = true;
          analysisStatus.textContent = '';
        }
      }
      drawSpectrum(canvasL, dataL, leftHz, peaks.peakL, 'l');
      drawSpectrum(canvasR, dataR, rightHz, peaks.peakR, 'r');
      holdClock = performance.now();
      raf = requestAnimationFrame(render);
    };

    const startViz = () => {
      if (raf) cancelAnimationFrame(raf);
      vizActive = true;
      raf = requestAnimationFrame(render);
    };

    const stopViz = () => {
      vizActive = false;
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
      holdClock = 0;
    };

    const ensureViz = async () => {
      await setupGraph();
    };

    playBtn?.addEventListener('click', async () => {
      try {
        await setupGraph();
        if (audio.paused) await audio.play();
        else audio.pause();
        setPlayerState();
      } catch {
        showLoadError();
      }
    });

    const showLoadError = () => {
      let el = root.querySelector('[data-load-error]');
      if (!el) {
        el = document.createElement('p');
        el.setAttribute('data-load-error', '');
        el.className = 'player-load-error muted';
        el.textContent = loadErrorMsg;
        root.querySelector('.player-transport')?.after(el);
      }
    };

    audio.addEventListener('error', showLoadError);

    audio.addEventListener('play', () => {
      setPlayerState();
      smoothPeakL = null;
      smoothPeakR = null;
      smoothBeat = null;
      smoothBandPct = { delta: 0.2, theta: 0.2, alpha: 0.2, beta: 0.2, gamma: 0.2 };
      bandHoldPct = { delta: 0, theta: 0, alpha: 0, beta: 0, gamma: 0 };
      bandHoldUntil = { delta: 0, theta: 0, alpha: 0, beta: 0, gamma: 0 };
      specHoldL = null;
      specHoldR = null;
      specHoldUntilL = null;
      specHoldUntilR = null;
      stereoLikely = true;
      stereoFrames = 0;
      setupGraph();
    });
    audio.addEventListener('pause', () => {
      setPlayerState();
      updateDetectUI({ peakL: null, peakR: null, beat: null });
      if (analysisStatus) {
        analysisStatus.hidden = true;
        analysisStatus.textContent = '';
      }
      stopViz();
    });
    audio.addEventListener('ended', () => {
      setPlayerState();
      updateDetectUI({ peakL: null, peakR: null, beat: null });
      stopViz();
    });

    audio.addEventListener('loadedmetadata', () => {
      if (durationEl) durationEl.textContent = fmt(audio.duration);
    });

    const syncScrub = () => {
      if (!scrub || !audio.duration) return;
      const pct = (audio.currentTime / audio.duration) * 100;
      scrub.value = String(Math.floor((audio.currentTime / audio.duration) * 1000));
      if (scrubAscii) scrubAscii.textContent = asciiTrack(pct);
    };

    audio.addEventListener('timeupdate', () => {
      syncScrub();
      if (currentEl) currentEl.textContent = fmt(audio.currentTime);
    });

    scrub?.addEventListener('input', () => {
      if (!audio.duration) return;
      audio.currentTime = (Number(scrub.value) / 1000) * audio.duration;
      if (scrubAscii) scrubAscii.textContent = asciiTrack((Number(scrub.value) / 1000) * 100);
    });

    root.querySelectorAll('[data-skip]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const delta = Number(btn.getAttribute('data-skip'));
        audio.currentTime = Math.max(0, Math.min(audio.duration || 0, audio.currentTime + delta));
      });
    });

    speedSel?.addEventListener('change', () => {
      audio.playbackRate = Number(speedSel.value);
    });

    volumeEl?.addEventListener('input', () => {
      applyVolume(Number(volumeEl.value));
    });

    applyVolume(volumeEl ? Number(volumeEl.value) : 100);
    setPlayerState();
    syncLiveFullscreenUi();

    liveFsBtn?.addEventListener('click', () => {
      toggleLiveFullscreen();
    });

    document.addEventListener('fullscreenchange', syncLiveFullscreenUi);
    document.addEventListener('webkitfullscreenchange', syncLiveFullscreenUi);
    document.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape' && liveStage?.classList.contains('is-fs')) {
        exitLiveFullscreen();
      }
    });

    techPanel?.addEventListener('toggle', () => {
      if (techPanel.open && !audio.paused) ensureViz();
    });

    if (!audio.paused) ensureViz();

    window.addEventListener('resize', () => {
      if (analyserL && vizActive) {
        const peaks = detectPeaks();
        drawSpectrum(canvasL, dataL, leftHz, peaks.peakL, 'l');
        drawSpectrum(canvasR, dataR, rightHz, peaks.peakR, 'r');
      }
    });
  });
</script>

